# Secrets — passed at runtime via `docker run -e HF_TOKEN=...`
.env
.env.*

# Local environments & caches
venv/
.venv/
__pycache__/
*.pyc

# Version control & tooling state
.git/
.dvc/
.claude/

# Experiment tracking (large, local-only)
mlruns/
mlflow.db
logs/

