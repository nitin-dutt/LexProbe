# Python
__pycache__/
*.pyc
*.pyo
venv/

# Environment — never commit secrets
.env
.env.*
*.pem
*.key
.dvc/config.local

# Data (tracked by DVC instead — the small .dvc pointer files ARE committed)
data/raw/*
!data/raw/*.dvc
data/processed/
data/archive/

# Run logs
logs/

# Models: weights stay out of git (tracked by DVC); the small .dvc pointer files are committed
models/**/*
!models/**/
!models/**/*.dvc

# MLflow
mlflow.db
mlruns/

# Generated reports / tool caches
drift_report.html
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Personal notes & planning docs — only README.md and the evaluation report are published
*.md
!/README.md
!reports/eval/comparison.md
!reports/eval/document_level.md
!reports/eval/recovery_stage1.md

# Retired / personal artifacts (not needed to run the code or verify the reported results)
reports/*
!reports/eval/
data/*.json
test_contract.txt

# Legacy scripts from the retired v2 pipeline (superseded by src/evaluate.py + src/compare_results.py)
src/baseline_eval.py
src/log_dataset_stats.py

# Personal study manual (local only)
study/

# Training mixes built from the frozen chunks (regenerable; v3 dataset stays DVC-pinned)
data/train_mixes/
data/processed_v4/

# 7-clause (dataset profile v4) results: the v6b scores, gate and reports that tests/README refer to
!reports/eval_v4/
reports/eval_v4/*.partial.json
!reports/eval_v4/recovery_stage1_v6b.md
!reports/eval_v4/comparison_v6b.md
!reports/eval_v4/model_comparison_v5_v6_v6b.md

# Synthetic data: the hand-written set is kept; the rejected 8B-generated files are not
data/synthetic/ld_v*
data/synthetic/*.partial.json
